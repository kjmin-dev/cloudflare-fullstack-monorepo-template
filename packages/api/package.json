{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "build": "wrangler deploy --dry-run --minify --outdir dist -e production",
    "deploy": "wrangler deploy --minify -e production",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:generate": "drizzle-kit generate",
    "db:push:local": "LOCAL_DB_PATH=$(ls -t .wrangler/state/v3/d1/miniflare-D1DatabaseObject/*.sqlite 2>/dev/null | head -1) drizzle-kit push",
    "db:push:remote": "drizzle-kit push",
    "db:studio:local": "LOCAL_DB_PATH=$(ls -t .wrangler/state/v3/d1/miniflare-D1DatabaseObject/*.sqlite 2>/dev/null | head -1) drizzle-kit studio",
    "db:studio:remote": "drizzle-kit studio",
    "db:migrate:local": "wrangler d1 migrations apply D1_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply D1_DB --remote -e production"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.2.0",
    "@scalar/hono-api-reference": "^0.9.30",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "better-sqlite3": "^12.5.0",
    "drizzle-kit": "^0.31.8"
  }
}
